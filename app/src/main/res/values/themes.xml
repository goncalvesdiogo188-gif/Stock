<resources>
    <color name="bg">#FFFFFF</color>
    <color name="ink">#1B1B1B</color>
    <color name="brand">#F07B1D</color>
    <color name="icon_bg">#1B1B1B</color>
    <color name="icon_fg">#F07B1D</color>
    <!-- Fundo branco; barra de estado preta como o cabeçalho da app. -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Android 8.0 não tem ícones escuros na barra de navegação: fica preta. -->
        <item name="android:navigationBarColor">@color/ink</item>
    </style>
</resources>
